# ============================================================
# Telegram Userbot — Hermes Auto-Reply — CONFIG EXAMPLE
# Salin jadi `.env` lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# ── Telegram API (wajib) — ambil di https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef0123456789
# Nama file session (dibuat otomatis pas login pertama)
SESSION_FILE=my_userbot.session

# ── Mode + Model ──
# UB_MODE=hermes   → pakai Hermes agent penuh (wajib install Hermes CLI)
# UB_MODE=llm      → mode sederhana: call OpenAI-compatible API langsung
UB_MODE=hermes
# Model/API provider — kalau UB_MODE=hermes, ini dipakai buat API fallback
UB_MODEL=deepseek/deepseek-v4-flash-0731
UB_API_KEY=
UB_BASE_URL=
UB_MAX_TOKENS=1200
UB_TEMPERATURE=0.7
UB_TIMEOUT=60

# ── Hermes agent (UB_MODE=hermes) ──
# API key buat provider hermes (dipakai hermes CLI via .hermes config)
HERMES_CUSTOM_INFERENCE_API_NOUSRESEARCH_COM_API_KEY=
# Toolsets yang dikasih ke agent sandbox (sama kayak Hermes CLI full:
# tambah vision, image_gen, tts, code_execution, kanban)
UB_HERMES_TOOLSETS=skills,memory,web,todo,session_search,terminal,file,browser,cronjob,delegation,vision,image_gen,tts,code_execution,kanban
# Timeout agent: idle (anggap macet) + hard limit (kill)
UB_HERMES_TIMEOUT=120
UB_HERMES_HARD_TIMEOUT=600
# Cooldown per user (detik) — 0 = tanpa delay
UB_HERMES_COOLDOWN=0
# Tool yang tool-bubble-nya di-sembunyiin
UB_HIDE_TOOLS=session_search,memory,todo

# ── Wake word / prefix ──
# Bot cuma bales pesan yang DIAWALI prefix ini (case-insensitive)
UB_REQUIRE_PREFIX=SONNET
# Perintah admin (dari akun sendiri)
UB_CMD_PREFIX=.ub

# ── Sandbox (wajib dibuatkan user OS + folder, lihat README) ──
UB_SANDBOX_USER=ubox
UB_SANDBOX_HOME=/srv/ubox
UB_SANDBOX_USERS=/srv/ubox/users
UB_SANDBOX_GROUPS=/srv/ubox/groups

# ── Voice Note (ElevenLabs) — opsional, kosongin kalau nggak mau VN ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=your_elevenlabs_keys
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.85
ELEVENLABS_VOLUME=0.85
ELEVENLABS_STABILITY=0.2
ELEVENLABS_STYLE=0.6
ELEVENLABS_SPEAKER_BOOST=1

# ── Lain-lain ──
UB_HISTORY=12
UB_SHOW_TOOLS=1
UB_MAX_MSG_CHARS=3500
UB_MSG_DELAY=0.8
UB_COOLDOWN=30

# ── History & session ──
# History grup yang di-inject ke agent pas session baru (0 = mati)
UB_GROUP_BACKFILL=50
# Rolling window history.md (baris obrolan yang ke-observed)
UB_HISTORY_ROLLING=100
# Session CLI di-kill kalau idle > N detik (0 = mati) — free RAM
UB_SESSION_IDLE_KILL=1800
# Pre-warm session di startup (comma-separated chat id; kosong = auto dari seen_chats)
UB_PREWARM_CHATS=
